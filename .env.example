BELLUM_DATABASE_URL=postgresql+psycopg://bellum_resources:change_me@localhost:5432/bellum_resources
TEST_DATABASE_URL=postgresql+psycopg://bellum_resources:change_me@localhost:5432/bellum_resources_test

# Admin is disabled until configured. Supply secrets externally; never commit them.
BELLUM_ADMIN_USERNAME=
BELLUM_ADMIN_PASSWORD=
BELLUM_UPLOAD_API_TOKEN=
BELLUM_CSRF_SECRET=
BELLUM_MAX_UPLOAD_BYTES=8388608
BELLUM_SNAPSHOT_FRESHNESS_HOURS=24
# Use false only for loopback HTTP development. Production requires HTTPS.
BELLUM_SECURE_COOKIES=true
# Native exports only: drops greater than 50% require explicit operator review.
BELLUM_NATIVE_MAX_REDUCTION_FRACTION=0.5
BELLUM_NATIVE_SUSTAINED_MAX_REDUCTION_FRACTION=0.5
BELLUM_NATIVE_REVIEW_OVERRIDES=false
