# Copy to .env.production on the eventual deployment host; chmod 600.
# Use independently generated URL-safe secrets, e.g. openssl rand -hex 32.
# Empty required values intentionally prevent Compose startup.
POSTGRES_DB=bellum_resources
POSTGRES_USER=bellum_resources
POSTGRES_PASSWORD=
# Compose expands the same credentials into the application URL.
# If using a non-URL-safe password, percent-encode it in an explicit URL instead.
BELLUM_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
BELLUM_ADMIN_USERNAME=resources-admin
BELLUM_ADMIN_PASSWORD=
BELLUM_UPLOAD_API_TOKEN=
BELLUM_CSRF_SECRET=
BELLUM_SECURE_COOKIES=true
# Required: exact TCP peer IP observed through the host's loopback-published port.
# Bootstrap locally with 127.0.0.1 to measure it; replace before enabling Nginx.
# Usually a Docker bridge gateway on Linux; do not assume localhost or 172.17.0.1.
# Comma-separated exact IPs only. Do not use * or a container-network CIDR.
BELLUM_FORWARDED_ALLOW_IPS=
BELLUM_SNAPSHOT_FRESHNESS_HOURS=24
BELLUM_MAX_UPLOAD_BYTES=8388608
BELLUM_NATIVE_MAX_REDUCTION_FRACTION=0.5
BELLUM_NATIVE_SUSTAINED_MAX_REDUCTION_FRACTION=0.5
BELLUM_NATIVE_REVIEW_OVERRIDES=false
BELLUM_HOST_PORT=18080
BELLUM_IMAGE_TAG=local
# For a custom path, also pass --env-file with the SAME path on every command.
BELLUM_ENV_FILE=.env.production
