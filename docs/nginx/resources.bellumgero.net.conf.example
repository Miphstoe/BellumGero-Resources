# Proposed standalone virtual host. Do not install until separately approved.
# Obtain this hostname's certificate before enabling the HTTPS block.
server {
    listen 80;
    listen [::]:80;
    server_name resources.bellumgero.net;
    return 301 https://resources.bellumgero.net$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name resources.bellumgero.net;
    ssl_certificate /etc/letsencrypt/live/resources.bellumgero.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/resources.bellumgero.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Default application file limit is 8 MiB; allow multipart overhead.
    client_max_body_size 9m;
    client_body_timeout 30s;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
